generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Post {
  id              String    @id @default(cuid())
  title           String
  titleJa         String    @default("")
  slug            String    @unique
  content         String    @default("")
  contentJa       String    @default("")
  excerpt         String    @default("")
  excerptJa       String    @default("")
  coverImage      String    @default("")
  category        String    @default("NEWS")
  status          String    @default("DRAFT")
  metaTitle       String    @default("")
  metaDescription String    @default("")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Work {
  id               String   @id @default(cuid())
  title            String
  titleJa          String   @default("")
  subtitle         String   @default("")
  category         String   @default("3DCG")      // 3DCG | Animation | VR | BIM
  type             String   @default("still")     // still | animation | composite | vr360 | walkthrough | ar | digital
  buildingCategory String   @default("residential") // residential | apartment | resort | commercial | office | public | urban
  image            String   @default("")
  beforeImage      String   @default("")
  videoUrl         String   @default("")           // YouTube embed URL
  vrUrl            String   @default("")           // VR360 iframe URL (e.g. https://vr.i8studio.vn/360/...)
  order            Int      @default(0)
  homeOrder        Int      @default(0)           // Thứ tự riêng trên trang chủ
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Service {
  id            String   @id @default(cuid())
  name          String
  nameJa        String   @default("")
  slug          String   @unique
  description   String   @default("")
  descriptionJa String   @default("")
  icon          String   @default("")
  image         String   @default("")
  priceHint     String   @default("")
  priceHintJa   String   @default("")
  order         Int      @default(0)
  isPublished   Boolean  @default(true)
  heroImage     String   @default("")
  heroVideo     String   @default("")    // Hero background video (mp4/webm) — autoplay on page load
  featuresJson  String   @default("[]")  // JSON array of {titleJa,titleEn,descJa,descEn,image,mediaEmbedUrl?,displayMode?,imageBefore?,imageAfter?}
  mediaEmbedUrl String   @default("")    // Service-level embed URL (video/VR360/3D)

  // Solution detail page fields (legacy — kept for backward compat)
  heroTaglineJa   String @default("")
  heroTaglineEn   String @default("")
  heroDescJa      String @default("")
  heroDescEn      String @default("")
  feature1TitleJa String @default("")
  feature1TitleEn String @default("")
  feature1DescJa  String @default("")
  feature1DescEn  String @default("")
  feature1Image   String @default("")
  feature2TitleJa String @default("")
  feature2TitleEn String @default("")
  feature2DescJa  String @default("")
  feature2DescEn  String @default("")
  feature2Image   String @default("")
  processJson     String @default("[]")   // JSON array of {titleJa,titleEn,descJa,descEn}
  plansJson       String @default("[]")   // JSON array of {name,features[],price,highlighted?}

  createdAt     DateTime @default(now())
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleJa     String   @default("")
  titleEn     String   @default("")
  descJa      String   @default("")
  descEn      String   @default("")
  coverImage  String   @default("")
  imagesJson  String   @default("[]")  // JSON array of image URLs (legacy)
  order       Int      @default(0)
  active      Boolean  @default(true)
  items       CollectionItem[]
  createdAt   DateTime @default(now())
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  image        String     @default("")
  captionJa    String     @default("")
  captionEn    String     @default("")
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
}

model PriceItem {
  id           String   @id @default(cuid())
  serviceSlug  String   @default("")
  icon         String   @default("")
  titleJa      String   @default("")
  titleEn      String   @default("")
  bulletsJson  String   @default("[]")  // JSON array of feature strings (JA)
  bulletsEnJson String   @default("[]")  // JSON array of feature strings (EN)
  priceFrom    String   @default("")    // e.g. "¥35,000〜" or "ASK"
  priceLabelJa String   @default("")
  priceLabelEn String   @default("")
  cardImage    String   @default("")    // Hero image for price card
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

model CompanyContent {
  id          String   @id @default(cuid())
  section     String   @unique  // "overview" | "milestones" | "workflow"
  contentJson String   @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model BlogCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameJa    String   @default("")
  nameEn    String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Slide {
  id         String   @id @default(cuid())
  title      String
  titleJa    String   @default("")
  subtitle   String   @default("")
  subtitleJa String   @default("")
  image      String   @default("")
  gradient   String   @default("")
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model QA {
  id         String   @id @default(cuid())
  question   String
  questionJa String   @default("")
  answer     String
  answerJa   String   @default("")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String
  clientTitle   String   @default("")
  clientCompany String   @default("")
  clientPhoto   String   @default("")
  quote         String
  quoteJa       String   @default("")
  rating        Int      @default(5)
  featured      Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String   @default("")
  url       String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CaseStudy {
  id          String   @id @default(cuid())
  title       String
  titleJa     String   @default("")
  slug        String   @unique
  client      String   @default("")
  challenge   String   @default("")
  challengeJa String   @default("")
  solution    String   @default("")
  solutionJa  String   @default("")
  result      String   @default("")
  resultJa    String   @default("")
  beforeImage String   @default("")
  afterImage  String   @default("")
  metrics     String   @default("")
  serviceType String   @default("")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}

model ContactSubmission {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  service     String   @default("")
  message     String
  hearAboutUs String   @default("") // Channel selected by user (Facebook, Instagram, LinkedIn, YouTube, Google, Referral, Other)
  referrer    String   @default("") // Auto-detected referrer or UTM parameters
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  source    String   @default("")
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  page      String   @default("")
  metadata  String   @default("")
  createdAt DateTime @default(now())
}

model Flipbook {
  id            String   @id @default(cuid())
  title         String
  titleJa       String   @default("")
  description   String   @default("")
  descriptionJa String   @default("")
  coverImage    String   @default("")
  pdfUrl        String
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id               String   @id @default(cuid())
  slug             String   @unique

  // Hero section
  category         String   @default("")
  eyebrow          String   @default("")
  title            String
  titleJp          String   @default("")
  subtitle         String   @default("")
  heroImage        String   @default("")

  // Intro section
  introDropcap     String   @default("")
  introPullquote   String   @default("")

  // Main content sections — stored as JSON array
  sections         String   @default("[]")

  // Comparison / Insight blocks
  comparisonBefore String   @default("")
  comparisonAfter  String   @default("")
  insightHeading   String   @default("")
  insightBody      String   @default("")

  // Metadata
  excerpt          String   @default("")
  coverImage       String   @default("")
  author           String   @default("")
  authorRole       String   @default("")
  readTime         Int      @default(5)
  publishedAt      DateTime @default(now())
  isPublished      Boolean  @default(false)
  isFeatured       Boolean  @default(false)

  // Multilingual
  locale           String   @default("ja")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CompositeExample {
  id          String   @id @default(cuid())
  title       String
  titleJp     String?
  category    String   // e.g. "Residential", "Commercial"
  location    String?
  beforeImage String   // URL to before/site photo
  afterImage  String   // URL to after/composite
  isFeatured  Boolean  @default(false) // featured = shows in the hero slider position
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Portfolio {
  id            String   @id @default(cuid())
  title         String
  titleJa       String   @default("")
  description   String   @default("")
  descriptionJa String   @default("")
  coverImage    String   @default("")
  galleryJson   String   @default("[]")
  category      String   @default("")
  order         Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HomeMedia {
  id        String   @id @default(cuid())
  title     String   @default("")
  image     String   @default("")        // Ảnh chính (thumbnail / hero background)
  videoUrl  String   @default("")        // Video file path hoặc YouTube URL
  type      String   @default("image")   // "image" | "video"
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
